<?xml version="1.0" encoding="utf-8"?>
<Wix
  xmlns="http://wixtoolset.org/schemas/v4/wxs"
  RequiredVersion="7.0.0">
  <Package
    Name="Orbit"
    Manufacturer="water2004"
    Version="$(var.OrbitVersion)"
    Language="1033"
    Scope="perMachine"
    ProductCode="*"
    UpgradeCode="D702E25B-F168-46F4-922F-797235883C37">

    <SummaryInformation
      Description="Orbit Minecraft workspace suite"
      Comments="Installs Orbit, Orbit Launcher, and the native Orbit desktop application." />

    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="A newer version of Orbit is already installed."
      Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPCOMMENTS" Value="Minecraft mod manager, runtime launcher, and native desktop application" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/water2004/orbit" />
    <Property Id="ARPPRODUCTICON" Value="OrbitGuiIcon.ico" />
    <Property Id="INSTALL_PROFILE" Value="complete" Secure="yes" />
    <Property Id="ADD_TO_PATH" Value="1" Secure="yes" />
    <Property Id="UNINSTALL_DATA_LEVEL" Value="cache" Secure="yes" />
    <Property Id="ORBIT_CLEANUP_OPTIONS_SEEN" Secure="yes" />
    <Property Id="ORBIT_DATA_CLEANUP_READY" Secure="yes" />
    <Property Id="OrbitRollbackCleanup" Hidden="yes" />
    <Property Id="OrbitStageCleanup" Hidden="yes" />
    <Property Id="OrbitCommitCleanup" Hidden="yes" />
    <Launch
      Condition="INSTALL_PROFILE = &quot;orbit&quot; OR INSTALL_PROFILE = &quot;launcher&quot; OR INSTALL_PROFILE = &quot;complete&quot;"
      Message="INSTALL_PROFILE must be orbit, launcher, or complete." />
    <Binary Id="OrbitCleanupActions" SourceFile="$(var.OrbitCleanupActions)" />
    <CustomAction Id="OrbitPrepareCleanup" BinaryRef="OrbitCleanupActions" DllEntry="OrbitPrepareCleanup" Execute="immediate" Return="check" />
    <CustomAction Id="OrbitRollbackCleanup" BinaryRef="OrbitCleanupActions" DllEntry="OrbitRollbackCleanup" Execute="rollback" Impersonate="yes" Return="check" HideTarget="yes" />
    <CustomAction Id="OrbitStageCleanup" BinaryRef="OrbitCleanupActions" DllEntry="OrbitStageCleanup" Execute="deferred" Impersonate="yes" Return="check" HideTarget="yes" />
    <CustomAction Id="OrbitCommitCleanup" BinaryRef="OrbitCleanupActions" DllEntry="OrbitCommitCleanup" Execute="commit" Impersonate="yes" Return="ignore" HideTarget="yes" />
    <CustomAction Id="ConfigureOrbitGuiBindings" FileRef="OrbitGuiExecutable" ExeCommand="--install-cli-bindings" Execute="commit" Impersonate="yes" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="OrbitPrepareCleanup" After="InstallValidate" Condition="Installed AND REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="OrbitRollbackCleanup" After="InstallInitialize" Condition="ORBIT_DATA_CLEANUP_READY = &quot;1&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="OrbitStageCleanup" After="OrbitRollbackCleanup" Condition="ORBIT_DATA_CLEANUP_READY = &quot;1&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="OrbitCommitCleanup" After="OrbitStageCleanup" Condition="ORBIT_DATA_CLEANUP_READY = &quot;1&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="ConfigureOrbitGuiBindings" After="InstallFiles" Condition="NOT UPGRADINGPRODUCTCODE AND NOT REMOVE = &quot;ALL&quot; AND (&amp;GuiFeature = 3 OR (!GuiFeature = 3 AND &amp;GuiFeature &lt;&gt; 2))" />
    </InstallExecuteSequence>

    <UIRef Id="OrbitInstallUI" />
    <WixVariable
      Id="WixUILicenseRtf"
      Value="$(var.OrbitLicenseRtf)" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Orbit">
        <Directory Id="BINDIR" Name="bin">
          <Component
            Id="OrbitExecutableComponent"
            Guid="E95362F5-0597-433F-B6E9-097580F3D55D"
            Bitness="always64">
            <File
              Id="OrbitExecutable"
              Source="$(var.OrbitExecutable)"
              Name="orbit.exe"
              KeyPath="yes" />
            <File
              Id="OrbitRuntimeAgent"
              Source="$(var.OrbitRuntimeAgent)"
              Name="orbit-runtime-agent.jar" />
            <!-- Installer-owned bookkeeping, including retired AppData path values. -->
            <RemoveRegistryKey Root="HKLM" Key="Software\water2004\Orbit" Action="removeOnUninstall" />
            <RemoveRegistryKey Root="HKLM" Key="Software\water2004\OrbitLauncher" Action="removeOnUninstall" />
          </Component>

          <Component
            Id="OrbitLauncherExecutableComponent"
            Guid="1AC20D13-AC3F-45B4-8C0A-33E774D38FD8"
            Bitness="always64">
            <File
              Id="OrbitLauncherExecutable"
              Source="$(var.OrbitLauncherExecutable)"
              Name="orbit-launcher.exe"
              KeyPath="yes" />
          </Component>

          <Component
            Id="OrbitGuiExecutableComponent"
            Guid="2E7E0ECD-363D-4AC5-87A2-6064BE4E65DA"
            Bitness="always64">
            <File
              Id="OrbitGuiExecutable"
              Source="$(var.OrbitGuiExecutable)"
              Name="orbit-gui.exe"
              KeyPath="yes">
              <Shortcut
                Id="OrbitGuiStartMenuShortcut"
                Directory="ProgramMenuFolder"
                Name="Orbit"
                Description="Manage Minecraft installations and mods"
                Advertise="yes"
                Icon="OrbitGuiIcon.ico"
                IconIndex="0"
                WorkingDirectory="INSTALLFOLDER" />
            </File>
          </Component>

          <Component
            Id="OrbitPathComponent"
            Guid="8478E52C-B686-4283-8CFF-229B36AECEE5"
            Bitness="always64">
            <Environment
              Id="OrbitSystemPath"
              Name="PATH"
              Value="[BINDIR]"
              Action="set"
              Part="last"
              Permanent="no"
              System="yes" />
            <RegistryValue
              Root="HKLM"
              Key="Software\water2004\Orbit"
              Name="PathIntegration"
              Type="integer"
              Value="1"
              KeyPath="yes" />
          </Component>
        </Directory>

        <Component
          Id="OrbitLicenseComponent"
          Guid="71FCFDC9-5FA3-4030-8588-E30C357B50F4">
          <File
            Id="OrbitLicense"
            Source="$(var.OrbitLicense)"
            Name="LICENSE.txt"
            KeyPath="yes" />
        </Component>
        <Component Id="OrbitGuiLicenseComponent" Guid="*">
          <File Id="OrbitGuiLicense" Source="$(var.OrbitGuiLicense)" Name="LICENSE-GUI.txt" KeyPath="yes" />
        </Component>
        <Component Id="OrbitGuiAttributionComponent" Guid="*">
          <File Id="OrbitGuiAttribution" Source="$(var.OrbitGuiAttribution)" Name="GUI-UPSTREAM.md" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Icon Id="OrbitGuiIcon.ico" SourceFile="$(var.OrbitGuiIcon)" />

    <Feature
      Id="OrbitFeature"
      Title="Orbit"
      Description="Minecraft mod and dependency management CLI."
      Level="1"
      AllowAbsent="no"
      AllowAdvertise="no">
      <ComponentRef Id="OrbitExecutableComponent" />
      <ComponentRef Id="OrbitLicenseComponent" />
    </Feature>

    <Feature
      Id="LauncherFeature"
      Title="Orbit Launcher"
      Description="Minecraft, loader, Java, account, and runtime management CLI."
      Level="1"
      AllowAbsent="yes"
      AllowAdvertise="no">
      <Level Condition="INSTALL_PROFILE = &quot;orbit&quot;" Value="0" />
      <ComponentRef Id="OrbitLauncherExecutableComponent" />
    </Feature>

    <Feature
      Id="GuiFeature"
      Title="Orbit GUI"
      Description="Native desktop interface for Orbit and Orbit Launcher."
      Level="1"
      AllowAbsent="yes"
      AllowAdvertise="no">
      <Level Condition="INSTALL_PROFILE &lt;&gt; &quot;complete&quot;" Value="0" />
      <ComponentRef Id="OrbitGuiExecutableComponent" />
      <ComponentRef Id="OrbitGuiLicenseComponent" />
      <ComponentRef Id="OrbitGuiAttributionComponent" />
    </Feature>

    <Feature
      Id="PathFeature"
      Title="Add Orbit to the system PATH"
      Description="Makes the orbit command available in new terminals."
      Level="1"
      AllowAbsent="yes"
      AllowAdvertise="no">
      <Level Condition="ADD_TO_PATH &lt;&gt; &quot;1&quot;" Value="0" />
      <ComponentRef Id="OrbitPathComponent" />
    </Feature>
  </Package>
</Wix>
